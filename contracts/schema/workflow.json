{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://github.com/Yorha9e/alasol/contracts/schema/workflow.json",
  "title": "Workflow",
  "description": "工作流定义（纯数据，跨边界）：能力包的提供与批准——哲学 + 子代理类型 + 上下文管理方式 + 门禁部件 + 预批准（W1，06 §4.1）。不是流程执行器；主 agent 自行编排（W21）。",
  "$defs": {
    "Workflow": {
      "type": "object",
      "required": ["v", "id", "philosophy", "context_strategy"],
      "properties": {
        "v": {
          "type": "integer",
          "description": "契约版本（F7）。"
        },
        "id": {
          "type": "string",
          "description": "工作流标识（如 build）。"
        },
        "command": {
          "type": "string",
          "description": "触发用 slash 命令名（W3）；缺省 = 显式触发。"
        },
        "philosophy": {
          "type": "string",
          "description": "工作哲学文本，注入 system prompt 供主 agent 选择（W2/W3）。"
        },
        "agent_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/AgentType" },
          "description": "能力池：子代理类型声明（W5）。"
        },
        "context_strategy": {
          "$ref": "#/$defs/ContextStrategy",
          "description": "上下文管理方式是工作流的一部分（W6）。"
        },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/Gate" },
          "description": "验收目标与门禁（W7）：同步门禁=数据驱动策略规则；异步任务=进程级部件。"
        },
        "grants": {
          "type": "array",
          "items": { "$ref": "#/$defs/Grant" },
          "description": "预批准（H22：是请求不是授予；实际 = 请求 ∩ 策略上限 ∩ 父级授予）。"
        }
      }
    },
    "AgentType": {
      "type": "object",
      "required": ["id", "prompt", "tools", "model"],
      "properties": {
        "id": {
          "type": "string",
          "description": "类型名（如 planner / coder / scout）。"
        },
        "prompt": {
          "type": "string",
          "description": "该类型的提示词（W5 用户可自定义）。"
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "工具名列表；不暴露即不存在（R5/R3）。"
        },
        "permission_request": {
          "$ref": "#/$defs/PermissionRequest",
          "description": "权限请求（H22：实际 = 请求 ∩ 策略上限 ∩ 父级授予）。"
        },
        "model": {
          "type": "string",
          "description": "模型绑定（如 default）。"
        },
        "can_spawn": {
          "type": "array",
          "items": { "type": "string" },
          "description": "可派生的子类型（K16/K17：类型可达性深度限制，运行时强制；空 = 不可再派）。"
        }
      }
    },
    "PermissionRequest": {
      "type": "object",
      "required": ["read", "write", "exec"],
      "properties": {
        "read": { "$ref": "#/$defs/ReadWriteLevel" },
        "write": { "$ref": "#/$defs/ReadWriteLevel" },
        "exec": { "$ref": "#/$defs/ExecLevel" }
      }
    },
    "ReadWriteLevel": {
      "type": "string",
      "enum": ["none", "workspace", "full"],
      "description": "读写范围请求（H6 预设的精神；实际取交集后生效）。"
    },
    "ExecLevel": {
      "type": "string",
      "enum": ["none", "allowlist", "full"],
      "description": "执行范围请求。"
    },
    "ContextStrategy": {
      "type": "object",
      "description": "上下文管理方式（kind + params）。**当前未接线**：仓里没有消费方读这个字段——v2-S1 的可配面走宿主配置面（host.Config / 用户级 TOML 的 context_strategy.kind/window/l1_pct/l2_pct → compaction.Params）。本字段保留契约形状（将来接上时不必改契约），但**别当它已经生效**。",
      "required": ["kind"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ContextStrategyKind",
          "description": "内置四种，用户可写扩展（J8）。"
        },
        "params": {
          "type": "object",
          "x-go-type": "json.RawMessage",
          "description": "策略参数（原始 JSON，按 kind 解释）。"
        }
      }
    },
    "ContextStrategyKind": {
      "type": "string",
      "enum": ["append", "stage_scoped", "sliding_window", "tiered"],
      "description": "上下文策略枚举（J8）：append 默认；tiered=分级压缩（v0 只预留接口，J12）。"
    },
    "Gate": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "description": "门禁标识（如 write-barrier / verify）。"
        },
        "kind": {
          "$ref": "#/$defs/GateKind"
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "policy.json#/$defs/PolicyRule" },
          "description": "kind=policy：同步门禁规则（W7b：必须进程内策略规则）。workflow 规则只可收窄（H5/H24）。"
        },
        "component": {
          "type": "string",
          "description": "kind=component：进程级异步部件名（如 ci.check），可热插拔、可替换。"
        },
        "params": {
          "type": "object",
          "x-go-type": "json.RawMessage",
          "description": "部件参数（原始 JSON，如 {\"cmd\": \"make ci\"}）。"
        }
      }
    },
    "GateKind": {
      "type": "string",
      "enum": ["policy", "component"],
      "description": "同步门禁类（数据驱动策略规则）/ 异步任务类（进程级部件）（W7）。"
    },
    "Grant": {
      "type": "object",
      "required": ["tool", "scope"],
      "properties": {
        "tool": {
          "type": "string",
          "description": "工具名。"
        },
        "scope": {
          "type": "string",
          "description": "授予范围（如 workspace）。命中已授予 scope 的调用直接放行（H23）。"
        }
      }
    }
  }
}
